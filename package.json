{
  "name": "deadline-four-v3-9-tactical-shop",
  "private": true,
  "version": "3.9.2",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @deadline/client",
    "build": "npm run build -w @deadline/client",
    "preview": "npm run preview -w @deadline/client",
    "typecheck": "npm run typecheck -w @deadline/client",
